# Copy to `.env` and fill in to use real satellite/fire data (data.source: cdse).
# `.env` is git-ignored. These are only needed for src/data/download.py.

# --- Copernicus Data Space Ecosystem (Sentinel-1) ---
# Register free at https://dataspace.copernicus.eu/
CDSE_USERNAME=
CDSE_PASSWORD=

# --- NASA FIRMS (active fire hotspots) ---
# Get a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Optional runtime overrides (see configs/config.yaml header) ---
# LOG_LEVEL=INFO
# SAR__TRAINING__DEVICE=cuda
# SAR__API__CONFIDENCE_THRESHOLD=0.65
